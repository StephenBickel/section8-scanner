# Required for authentication and persisted app data
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The default is a safe, public demo that does not run a scraper.
SCANNER_MODE=demo

# Required only when SCANNER_MODE=remote
SCANNER_API_URL=https://your-scanner.example.com
SCANNER_API_KEY=replace-with-a-long-random-secret

# Required only when SCANNER_MODE=local or when running api_server.py
SCANNER_PYTHON=python3
SCANNER_SCRIPT=./scanner.py
SCANNER_MAX_CONCURRENT=1
SCANNER_TIMEOUT_SECONDS=280
ALLOWED_ORIGINS=https://your-app.example.com
HUD_API_TOKEN=your-hud-api-token
SCANNER_MODULE_PATH=/absolute/path/to/your-scanner-provider

# Optional product integrations
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_INVESTOR=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_API_KEY=

# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
